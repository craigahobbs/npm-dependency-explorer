include <unittest.bare>


# Start coverage
unittestCoverageStart()

# Coverage includes (in lieu of tests)
include '../npmDependencyExplorer.bare'
include '../npm.bare'

# Test includes
include 'testSemver.bare'
include 'testNpm.bare'
include 'testNpmDependencyExplorer.bare'

# Stop coverage
unittestCoverageStop()

# Test report
return unittestReport({ \
    'coverageExclude': ['runTests.bare'], \
    'coverageMin': 100 \
})
