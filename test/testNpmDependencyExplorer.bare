include <dataLineChart.bare>
include <unittest.bare>
include <unittestMock.bare>

include '../npmDependencyExplorer.bare'


# Mock npm registry data (map of package data URL to package data JSON text) for the npm Dependency Explorer tests
testNdeRegistryData = { \
    'https://registry.npmjs.org/root': jsonStringify({ \
        'dist-tags': {'latest': '2.0.0'}, \
        'versions': { \
            '1.0.0': {'version': '1.0.0', 'description': 'Root package', 'dependencies': {'a': '^1.0.0'}}, \
            '2.0.0': { \
                'version': '2.0.0', \
                'description': 'Root package', \
                'dependencies': {'a': '^1.0.0', 'b': '~1.0.0', 'missing': '^1.0.0'}, \
                'devDependencies': {'d': '^1.0.0'} \
            } \
        } \
    }), \
    'https://registry.npmjs.org/a': jsonStringify({ \
        'dist-tags': {'latest': '1.2.0'}, \
        'versions': { \
            '1.0.0': {'version': '1.0.0'}, \
            '1.2.0': {'version': '1.2.0', 'dependencies': {'b': '^2.0.0'}} \
        } \
    }), \
    'https://registry.npmjs.org/b': jsonStringify({ \
        'dist-tags': {'latest': '2.0.0'}, \
        'versions': { \
            '1.0.0': {'version': '1.0.0'}, \
            '1.0.5': {'version': '1.0.5'}, \
            '2.0.0': {'version': '2.0.0'} \
        } \
    }), \
    'https://registry.npmjs.org/d': jsonStringify({ \
        'dist-tags': {'latest': '1.0.0'}, \
        'versions': {'1.0.0': {'version': '1.0.0'}} \
    }) \
}


# The debug message logged when the "missing" package's range cannot be resolved
testNdeMissingDebug = 'npm: Un-matched SemVer range "^1.0.0" for package "missing", using "null" (latest)'


#
# ndeMain - package selection form
#


async function testNdeMain_form():
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()

    unittestDeepEqual(calls, [ \
        ['markdownPrint', ['Home | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer']], \
        ['elementModelRender', [ \
            [ \
                { \
                    'html': 'p', \
                    'elem': { \
                        'html': 'b', \
                        'elem': {'text': 'Package Name:'} \
                    } \
                }, \
                { \
                    'html': 'p', \
                    'elem': { \
                        'html': 'input', \
                        'attr': { \
                            'autocomplete': 'off', \
                            'id': 'package-name-text', \
                            'style': 'font-size: inherit; border: thin solid black; padding: 0.4em;', \
                            'type': 'text', \
                            'value': null, \
                            'size': 30 \
                        }, \
                        'callback': {'keyup': '<function>'} \
                    } \
                }, \
                { \
                    'html': 'p', \
                    'elem': { \
                        'html': 'a', \
                        'attr': {'style': 'cursor: pointer; user-select: none;'}, \
                        'elem': {'text': 'Explore Dependencies'}, \
                        'callback': {'click': '<function>'} \
                    } \
                } \
            ] \
        ]], \
        ['documentSetFocus', ['package-name-text']], \
        ['markdownPrint', ['','## Examples']], \
        ['markdownPrint', ['',"[bare\\-script](#var.vName='bare-script')"]], \
        ['markdownPrint', ['',"[c8](#var.vName='c8')"]], \
        ['markdownPrint', ['',"[element\\-model](#var.vName='element-model')"]], \
        ['markdownPrint', ['',"[eslint](#var.vName='eslint')"]], \
        ['markdownPrint', ['',"[jsdoc](#var.vName='jsdoc')"]], \
        ['markdownPrint', ['',"[jsdom](#var.vName='jsdom')"]], \
        ['markdownPrint', ['',"[markdown\\-model](#var.vName='markdown-model')"]], \
        ['markdownPrint', ['',"[markdown\\-up](#var.vName='markdown-up')"]], \
        ['markdownPrint', ['',"[npm](#var.vName='npm')"]], \
        ['markdownPrint', ['',"[schema\\-markdown](#var.vName='schema-markdown')"]] \
    ])
endfunction
unittestRunTest('testNdeMain_form')


