        ['documentSetTitle', ['npm Dependency Explorer - root']], \
        ['markdownPrint', [ \
            '', \
            '## [root](https://www.npmjs.com/package/root)', \
            '', \
            '**Description:** Root package' \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Version:** 2.0.0', \
            "([versions](#var.vName='root'&var.vVersion='2.0.0'&var.vVersionSelect=true&var.vWarn=true) | ", \
            "[chart](#var.vName='root'&var.vVersion='2.0.0'&var.vVersionChart=true&var.vWarn=true))" \
        ]], \
        ['systemLogDebug', [testNdeMissingDebug]], \
        ['markdownPrint', [ \
            '', \
            '**Direct dependencies:** 2 \\', \
            '**Total dependencies:** 3', \
            '', \
            "**Type:** Package | [Development](#var.vDev=true&var.vName='root'&var.vVersion='2.0.0'&var.vWarn=true)" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '### Warnings', \
            '', \
            'There are 2 warnings.' + stringFromCharCode(160) + '', \
            "[Hide](#var.vName='root'&var.vVersion='2.0.0')" \
        ]], \
        ['markdownPrint', ['','- Unknown version \\"^1.0.0\\" of package \\"missing\\"']], \
        ['markdownPrint', ['','- Multiple versions of package \\"b\\" \\(\\"1.0.5\\", \\"2.0.0\\"\\)']], \
        ['markdownPrint', [ \
            '', \
            '### Dependencies', \
            '', \
            "**Sort:** Name | [Dependencies](#var.vName='root'&var.vSort=true&var.vVersion='2.0.0'&var.vWarn=true) \\", \
            "**Direct:** All | [Direct](#var.vDirect=true&var.vName='root'&var.vVersion='2.0.0'&var.vWarn=true) \\", \
            "**Latest:** All | [Latest](#var.vLatest=true&var.vName='root'&var.vVersion='2.0.0'&var.vWarn=true)" \
        ]], \
        ['markdownPrint', [ \
            [ \
                '| Package                                       | Version | Latest | Range  | Dependent                                           | Dependent Version | Dependencies |', \
                '|-----------------------------------------------|---------|--------|--------|-----------------------------------------------------|-------------------|--------------|', \
                "| [a](#var.vName='a'&var.vVersion='1.2.0'&_top) | 1.2.0   |        | ^1.0.0 | [root](#var.vName='root'&var.vVersion='2.0.0'&_top) | 2.0.0             | 1            |", \
                "| [b](#var.vName='b'&var.vVersion='1.0.5'&_top) | 1.0.5   | 2.0.0  | ~1.0.0 | [root](#var.vName='root'&var.vVersion='2.0.0'&_top) | 2.0.0             | 0            |", \
                "| [b](#var.vName='b'&var.vVersion='2.0.0'&_top) | 2.0.0   |        | ^2.0.0 | [a](#var.vName='a'&var.vVersion='1.2.0'&_top)       | 1.2.0             | 0            |" \
            ] \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_packageWarningsShown')


async function testNdeMain_packageFiltersAndSort():
    systemGlobalSet('vName', 'root')
    systemGlobalSet('vVersion', '2.0.0')
    systemGlobalSet('vSort', true)
    systemGlobalSet('vDirect', true)
    systemGlobalSet('vLatest', true)
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)
    systemGlobalSet('vSort', null)
    systemGlobalSet('vDirect', null)
    systemGlobalSet('vLatest', null)

    # With sort/direct/latest active, the active option is plain text and the alternative is a link
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/root']], \
        ['systemFetch', [ \
            [ \
                'https://registry.npmjs.org/a', \
                'https://registry.npmjs.org/b', \
                'https://registry.npmjs.org/missing' \
            ] \
        ]], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer - root']], \
        ['markdownPrint', [ \
            '', \
            '## [root](https://www.npmjs.com/package/root)', \
            '', \
            '**Description:** Root package' \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Version:** 2.0.0', \
            "([versions](#var.vDirect=true&var.vLatest=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0'&var.vVersionSelect=true) | ", \
            "[chart](#var.vDirect=true&var.vLatest=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0'&var.vVersionChart=true))" \
        ]], \
        ['systemLogDebug', [testNdeMissingDebug]], \
        ['markdownPrint', [ \
            '', \
            '**Direct dependencies:** 2 \\', \
            '**Total dependencies:** 3', \
            '', \
            "**Type:** Package | [Development](#var.vDev=true&var.vDirect=true&var.vLatest=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0')" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '### Warnings', \
            '', \
            'There are 2 warnings.' + stringFromCharCode(160) + '', \
            "[Show](#var.vDirect=true&var.vLatest=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0'&var.vWarn=true)" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '### Dependencies', \
            '', \
            "**Sort:** [Name](#var.vDirect=true&var.vLatest=true&var.vName='root'&var.vVersion='2.0.0') | Dependencies \\", \
            "**Direct:** [All](#var.vLatest=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0') | Direct \\", \
            "**Latest:** [All](#var.vDirect=true&var.vName='root'&var.vSort=true&var.vVersion='2.0.0') | Latest" \
        ]], \
        ['markdownPrint', [ \
            [ \
                '| Package                                       | Version | Latest | Range  | Dependent                                           | Dependent Version | Dependencies |', \
                '|-----------------------------------------------|---------|--------|--------|-----------------------------------------------------|-------------------|--------------|', \
                "| [b](#var.vName='b'&var.vVersion='1.0.5'&_top) | 1.0.5   | 2.0.0  | ~1.0.0 | [root](#var.vName='root'&var.vVersion='2.0.0'&_top) | 2.0.0             | 0            |" \
            ] \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_packageFiltersAndSort')


async function testNdeMain_packageDev():
    systemGlobalSet('vName', 'root')
    systemGlobalSet('vVersion', '2.0.0')
    systemGlobalSet('vDev', true)
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)
    systemGlobalSet('vDev', null)

    # Development dependencies: the "*Development*" descriptor and the "Development Dependencies" header (1 dep: d)
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/root']], \
        ['systemFetch', [ \
            [ \
                'https://registry.npmjs.org/d' \
            ] \
        ]], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
