            "**Direct:** All | [Direct](#var.vDev=true&var.vDirect=true&var.vName='root'&var.vVersion='2.0.0')", \
            '' \
        ]], \
        ['markdownPrint', [ \
            [ \
                '| Package                                       | Version | Range  | Dependent                                           | Dependent Version | Dependencies |', \
                '|-----------------------------------------------|---------|--------|-----------------------------------------------------|-------------------|--------------|', \
                "| [d](#var.vName='d'&var.vVersion='1.0.0'&_top) | 1.0.0   | ^1.0.0 | [root](#var.vName='root'&var.vVersion='2.0.0'&_top) | 2.0.0             | 0            |" \
            ] \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_packageDev')


async function testNdeMain_packageNoLatestNoWarnings():
    systemGlobalSet('vName', 'a')
    systemGlobalSet('vVersion', '1.2.0')
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)

    # "a" has one dependency (b@2.0.0, already latest) and no warnings: no Warnings section, no "Latest" filter
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/a']], \
        ['systemFetch', [ \
            [ \
                'https://registry.npmjs.org/b' \
            ] \
        ]], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer - a']], \
        ['markdownPrint', [ \
            '', \
            '## [a](https://www.npmjs.com/package/a)', \
            '', \
            '**Description:** ' \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Version:** 1.2.0', \
            "([versions](#var.vName='a'&var.vVersion='1.2.0'&var.vVersionSelect=true) | ", \
            "[chart](#var.vName='a'&var.vVersion='1.2.0'&var.vVersionChart=true))" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Direct dependencies:** 1 \\', \
            '**Total dependencies:** 1', \
            '', \
            "**Type:** Package | [Development](#var.vDev=true&var.vName='a'&var.vVersion='1.2.0')" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '### Dependencies', \
            '', \
            "**Sort:** Name | [Dependencies](#var.vName='a'&var.vSort=true&var.vVersion='1.2.0') \\", \
            "**Direct:** All | [Direct](#var.vDirect=true&var.vName='a'&var.vVersion='1.2.0')", \
            '' \
        ]], \
        ['markdownPrint', [ \
            [ \
                '| Package                                       | Version | Range  | Dependent                                     | Dependent Version | Dependencies |', \
                '|-----------------------------------------------|---------|--------|-----------------------------------------------|-------------------|--------------|', \
                "| [b](#var.vName='b'&var.vVersion='2.0.0'&_top) | 2.0.0   | ^2.0.0 | [a](#var.vName='a'&var.vVersion='1.2.0'&_top) | 1.2.0             | 0            |" \
            ] \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_packageNoLatestNoWarnings')


async function testNdeMain_packageNoDependencies():
    systemGlobalSet('vName', 'b')
    systemGlobalSet('vVersion', '1.0.5')
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)

    # "b"@1.0.5 has no dependencies: stats show 0 and there is no dependency table or Warnings section
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/b']], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer - b']], \
        ['markdownPrint', [ \
            '', \
            '## [b](https://www.npmjs.com/package/b)', \
            '', \
            '**Description:** ' \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Version:** 1.0.5', \
            "([versions](#var.vName='b'&var.vVersion='1.0.5'&var.vVersionSelect=true) | ", \
            "[chart](#var.vName='b'&var.vVersion='1.0.5'&var.vVersionChart=true))" \
        ]], \
        ['markdownPrint', [ \
            '', \
            '**Direct dependencies:** 0 \\', \
            '**Total dependencies:** 0', \
            '', \
            "**Type:** Package | [Development](#var.vDev=true&var.vName='b'&var.vVersion='1.0.5')" \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_packageNoDependencies')


#
# ndeMain - version select and version chart
#


async function testNdeMain_versionSelect():
    systemGlobalSet('vName', 'b')
    systemGlobalSet('vVersion', '2.0.0')
    systemGlobalSet('vVersionSelect', true)
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)
    systemGlobalSet('vVersionSelect', null)

    # The version links page (newest first; the latest version is tagged)
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/b']], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer - b']], \
        ['markdownPrint', [ \
            '', \
            '## [b](https://www.npmjs.com/package/b)', \
            '', \
            '**Description:** ' \
        ]], \
        ['markdownPrint', [ \
            '', \
            "[Back to package](#var.vName='b'&var.vVersion='2.0.0')", \
            '', \
            '### Versions' \
        ]], \
        ['markdownPrint', ['',"[2.0.0](#var.vName='b'&var.vVersion='2.0.0'&_top) (latest)"]], \
        ['markdownPrint', ['',"[1.0.5](#var.vName='b'&var.vVersion='1.0.5'&_top)"]], \
        ['markdownPrint', ['',"[1.0.0](#var.vName='b'&var.vVersion='1.0.0'&_top)"]] \
    ])
endfunction
unittestRunTest('testNdeMain_versionSelect')


async function testNdeMain_versionChart():
    systemGlobalSet('vName', 'b')
    systemGlobalSet('vVersion', '2.0.0')
    systemGlobalSet('vVersionChart', true)
    unittestMockAll({'systemFetch': testNdeRegistryData})

    ndeMain()

    calls = unittestMockEnd()
    systemGlobalSet('vName', null)
    systemGlobalSet('vVersion', null)
    systemGlobalSet('vVersionChart', null)

    # The version dependency chart page renders a chart and a table (two element-model renders)
    unittestDeepEqual(calls, [ \
        ['systemFetch', ['https://registry.npmjs.org/b']], \
        ['markdownPrint', ['[Home](#var=) | [About](#url=README.md)']], \
        ['markdownPrint', ['','# npm Dependency Explorer']], \
        ['documentSetTitle', ['npm Dependency Explorer - b']], \
        ['markdownPrint', [ \
            '', \
            '## [b](https://www.npmjs.com/package/b)', \
            '', \
            '**Description:** ' \
        ]], \
        ['markdownPrint', [ \
            '', \
            "[Back to package](#var.vName='b'&var.vVersion='2.0.0')", \
            '', \
            '### Dependencies Chart' \
        ]], \
        ['elementModelRender', [ \
            { \
                'html': 'p', \
                'elem': dataLineChartElements( \
                    [ \
                        {'Version Index': 2, 'Dependencies': 0}, \
                        {'Version Index': 1, 'Dependencies': 0}, \
                        {'Version Index': 0, 'Dependencies': 0} \
                    ], \
                    { \
                        'width': 800, \
                        'height': 300, \
                        'x': 'Version Index', \
                        'y': ['Dependencies'], \
                        'xTicks': {'count': 5}, \
                        'yTicks': {'count': 5, 'start': 0}, \
                        'precision': 1 \
                    } \
                ) \
            } \
        ]], \
        ['markdownPrint', [ \
            [ \
                '| Version Index | Version                                           | Dependencies |', \
                '|---------------|---------------------------------------------------|--------------|', \
                "| 2             | [2.0.0](#var.vName='b'&var.vVersion='2.0.0'&_top) | 0            |", \
                "| 1             | [1.0.5](#var.vName='b'&var.vVersion='1.0.5'&_top) | 0            |", \
                "| 0             | [1.0.0](#var.vName='b'&var.vVersion='1.0.0'&_top) | 0            |" \
            ] \
        ]] \
    ])
endfunction
unittestRunTest('testNdeMain_versionChart')


#
# ndePackageNameOnClick
#


function testNdePackageNameOnClick():
    unittestMockAll({'documentInputValue': {'package-name-text': '  lodash  '}})

    ndePackageNameOnClick()

    calls = unittestMockEnd()

    # The trimmed package name is navigated to
    unittestDeepEqual(calls, [ \
        ['documentInputValue', ['package-name-text']], \
        ['windowSetLocation', ["#var.vName='lodash'"]] \
    ])
endfunction
unittestRunTest('testNdePackageNameOnClick')
